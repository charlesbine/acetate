# Copy to .env and fill in. (.env is gitignored — never commit it.)
#
# Register your own Spotify app: https://developer.spotify.com/dashboard
#   - copy its Client ID / Secret below
#   - add the exact Redirect URI below to your app's "Redirect URIs"
#
# Plaintext values are the default. Optional: if you use the 1Password CLI (`op`),
# any credential below can also be an `op://` secret reference (see acetate/auth.py).

SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional — Last.fm API key for genre tags and co-listening similarity:
# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional — OpenRouter (or OpenAI-compatible) API key for the dashboard chat agent.
# For local Ollama / keyless gateways, set any non-empty placeholder (e.g. ollama).
OPENROUTER_API_KEY=

# Optional — OpenAI-compatible chat endpoint (defaults to https://openrouter.ai/api/v1).
# Point at Ollama (http://127.0.0.1:11434/v1), LiteLLM, or any OpenAI-compatible proxy.
ACETATE_LLM_BASE_URL=

# Optional — default chat model ID from the allowlist in acetate/agent.py
ACETATE_LLM_MODEL=

# Optional — upstream model prefix for gateways such as LiteLLM (e.g. openrouter/)
ACETATE_LLM_MODEL_PREFIX=

# Optional — public URL sent in OpenRouter's HTTP-Referer header
# Defaults to https://github.com/charlesbine/acetate
ACETATE_PUBLIC_URL=

# Optional — identifying User-Agent sent to MusicBrainz (1 req/s policy)
# Defaults to acetate/0.2 (+https://github.com/charlesbine/acetate)
ACETATE_USER_AGENT=

# Optional — display timezone for dashboard pages and chat tool results (DB stays UTC)
ACETATE_TZ=America/New_York

# Optional — cap the chat model's context window (tokens); minimum 4096.
# Catalog metadata is used by default, with a 32768-token fallback for unknown models.
ACETATE_CHAT_CONTEXT_TOKENS=

# Optional — web auth mode: `local` (default for direct uvicorn runs) or `authelia`
# (default inside Docker, fail-closed unless trusted Remote-User headers are present).
# ACETATE_AUTH_MODE=local

# Optional — Authelia role mappings (comma-separated, case-insensitive)
# ACETATE_ADMIN_GROUPS=acetate-admin
# ACETATE_QUERY_GROUPS=acetate-query
# ACETATE_ADMIN_USERS=
